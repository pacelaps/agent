<Project Sdk="Microsoft.NET.Sdk">

  <!-- The operator's program in WPF (the agent's WPF plan). The logic is in Hosting; this draws it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>PaceLaps.Agent.App</RootNamespace>
    <AssemblyName>pacelaps-agent</AssemblyName>
    <ApplicationIcon>Assets\pacelaps-agent.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main, not the one WPF generates for App.xaml: the version switch, the render switch and one instance come first. -->
    <StartupObject>PaceLaps.Agent.App.Program</StartupObject>
  </PropertyGroup>

  <!-- A release build belongs to one server: scripts/publish.ps1 -Server (the release workflow) builds it in. -->
  <ItemGroup Condition="'$(ReleaseServer)' != ''">
    <AssemblyMetadata Include="ReleaseServer" Value="$(ReleaseServer)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\pacelaps-agent.ico" />
    <Resource Include="Assets\tray-*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaceLaps.Agent.Core\PaceLaps.Agent.Core.csproj" />
    <ProjectReference Include="..\PaceLaps.Agent.IRacing\PaceLaps.Agent.IRacing.csproj" />
    <ProjectReference Include="..\PaceLaps.Agent.Hosting\PaceLaps.Agent.Hosting.csproj" />
  </ItemGroup>

</Project>
