<!-- Small shared templates: the check mark of a self-test step (tick, warning, cross, dash). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tray="clr-namespace:PaceLaps.Agent.Hosting.Tray;assembly=PaceLaps.Agent.Hosting">
    <DataTemplate x:Key="CheckMark">
        <Path x:Name="Mark" Width="14" Height="14" Stretch="Uniform" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Data="M5,12 H19" Stroke="{StaticResource GreyDot}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Static tray:StatusCheck.Ok}">
                <Setter TargetName="Mark" Property="Data" Value="M20,6 L9,17 L4,12" />
                <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource GreenText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Static tray:StatusCheck.Problem}">
                <Setter TargetName="Mark" Property="Data" Value="M18,6 L6,18 M6,6 L18,18" />
                <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource RedText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Static tray:StatusCheck.Warning}">
                <Setter TargetName="Mark" Property="Data" Value="M12,4 V14 M12,20 V20.5" />
                <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource YellowText}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
