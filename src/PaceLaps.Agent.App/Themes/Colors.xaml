<!--
    The app's colours: Race Control's dark theme (webservice/resources/css/tokens.css, the pl- values of .dark),
    plus a few shades the design canvas uses between them. ColoursTests checks the token values against the tokens file.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokens (name = the token after the pl- prefix) -->
    <Color x:Key="canvas">#09090B</Color>
    <Color x:Key="surface">#111114</Color>
    <Color x:Key="surface-raised">#18181B</Color>
    <Color x:Key="fg">#FAFAFA</Color>
    <Color x:Key="fg-muted">#A1A1AA</Color>
    <Color x:Key="fg-subtle">#8B8B94</Color>
    <Color x:Key="line">#27272A</Color>
    <Color x:Key="line-strong">#71717A</Color>
    <Color x:Key="state-green">#22C55E</Color>
    <Color x:Key="state-green-soft">#10261A</Color>
    <Color x:Key="state-green-text">#4ADE80</Color>
    <Color x:Key="state-yellow">#FACC15</Color>
    <Color x:Key="state-yellow-soft">#2A2410</Color>
    <Color x:Key="state-yellow-text">#FDE047</Color>
    <Color x:Key="state-red">#DC2626</Color>
    <Color x:Key="state-red-soft">#2C1314</Color>
    <Color x:Key="state-red-text">#F87171</Color>
    <Color x:Key="state-blue">#155DFC</Color>
    <Color x:Key="state-blue-soft">#0F1A33</Color>
    <Color x:Key="state-blue-text">#7EA6FF</Color>
    <Color x:Key="state-grey">#52525B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Canvas" Color="{StaticResource canvas}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource surface}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource surface-raised}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#27272A" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource fg}" />
    <SolidColorBrush x:Key="FgMuted" Color="{StaticResource fg-muted}" />
    <SolidColorBrush x:Key="FgSubtle" Color="{StaticResource fg-subtle}" />
    <SolidColorBrush x:Key="FgDisabled" Color="#71717A" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource line}" />
    <SolidColorBrush x:Key="LineSubtle" Color="#1F1F23" />
    <SolidColorBrush x:Key="LineControl" Color="#3F3F46" />
    <SolidColorBrush x:Key="Brand" Color="{StaticResource state-blue}" />
    <SolidColorBrush x:Key="BrandHover" Color="#2B6CFF" />
    <SolidColorBrush x:Key="BrandText" Color="{StaticResource state-blue-text}" />
    <SolidColorBrush x:Key="BrandSoft" Color="{StaticResource state-blue-soft}" />
    <SolidColorBrush x:Key="BrandBorder" Color="#1E3A8A" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource state-green}" />
    <SolidColorBrush x:Key="GreenSoft" Color="{StaticResource state-green-soft}" />
    <SolidColorBrush x:Key="GreenText" Color="{StaticResource state-green-text}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource state-yellow}" />
    <SolidColorBrush x:Key="YellowSoft" Color="{StaticResource state-yellow-soft}" />
    <SolidColorBrush x:Key="YellowText" Color="{StaticResource state-yellow-text}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource state-red}" />
    <SolidColorBrush x:Key="RedSoft" Color="{StaticResource state-red-soft}" />
    <SolidColorBrush x:Key="RedText" Color="{StaticResource state-red-text}" />
    <SolidColorBrush x:Key="RedBorder" Color="#5C1D1F" />
    <SolidColorBrush x:Key="RedCard" Color="#170B0C" />
    <SolidColorBrush x:Key="Grey" Color="{StaticResource state-grey}" />
    <SolidColorBrush x:Key="GreyDot" Color="#71717A" />

    <!-- The local failsafe's hazard stripes -->
    <DrawingBrush x:Key="Hazard" TileMode="Tile" Viewport="0,0,36,4" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Red}" Geometry="M0,0 H18 V4 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Yellow}" Geometry="M18,0 H36 V4 H18 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
