<UserControl x:Class="PaceLaps.Agent.App.Shell.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The design canvas's "Status": the state card, four tiles, the last self-test. DataContext: StatusPageModel. -->
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The state card -->
        <Border Grid.Row="0" CornerRadius="14" BorderThickness="1"
                Background="{Binding View.Strip, Converter={StaticResource ProblemCard}, ConverterParameter=card}"
                BorderBrush="{Binding View.Strip, Converter={StaticResource ProblemCard}, ConverterParameter=border}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="4" CornerRadius="13,13,0,0" Background="{Binding View.Strip, Converter={StaticResource StripBrush}}" />
                <Grid Margin="24,22,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="{Binding View.Strip, Converter={StaticResource StripDot}, ConverterParameter=halo}" />
                                <Ellipse Width="8" Height="8" Fill="{Binding View.Strip, Converter={StaticResource StripDot}}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Eyebrow}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding View.Eyebrow, Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Display}" Margin="0,10,0,0" Text="{Binding View.Title, Converter={StaticResource Upper}}" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" MaxWidth="470" HorizontalAlignment="Left" Text="{Binding View.Sentence}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <StackPanel HorizontalAlignment="Right" Visibility="{Binding View.SideName, Converter={StaticResource Shown}}">
                            <TextBlock Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" Text="{Binding View.SideLabel, Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                            <TextBlock Style="{StaticResource DisplaySmall}" Margin="0,4,0,0" HorizontalAlignment="Right" TextAlignment="Right" MaxWidth="260"
                                       Text="{Binding View.SideName, Converter={StaticResource Upper}}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Margin="0,12,0,0" Height="28" CornerRadius="14" Padding="12,0" Background="{StaticResource GreenSoft}"
                                Visibility="{Binding View.Role, Converter={StaticResource Shown}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M20,6 L9,17 L4,12" Stroke="{StaticResource GreenText}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GreenText}" Text="{Binding View.Role}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Btn}" Margin="0,12,0,0" HorizontalAlignment="Right" Content="{Binding ActionText}" Command="{Binding ActCommand}"
                                Visibility="{Binding View.Action, Converter={StaticResource Shown}}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Tiles: iRacing, Race Control, Typing, Local failsafe -->
        <ItemsControl Grid.Row="1" Margin="0,16,-12,0" ItemsSource="{Binding View.Tiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14" BorderBrush="{Binding Check, Converter={StaticResource CheckBorder}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding Label, Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Check, Converter={StaticResource CheckBrush}}" />
                                <TextBlock Style="{StaticResource Value}" Margin="8,0,0,0" Text="{Binding Value}"
                                           Foreground="{Binding Check, Converter={StaticResource CheckBrush}, ConverterParameter=text}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Text="{Binding Detail}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The last self-test -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" Text="{Binding View.SelfTestSummary}" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Self-test" />
                </DockPanel>
                <ItemsControl Margin="0,10,0,0" VerticalAlignment="Top" ItemsSource="{Binding View.SelfTestSteps}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4,16,4">
                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Check, Converter={StaticResource CheckBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Margin="8,0,10,0" FontSize="13" FontWeight="SemiBold" Text="{Binding Label}" />
                                <TextBlock FontSize="13" Foreground="{StaticResource FgMuted}" TextTrimming="CharacterEllipsis" Text="{Binding Text}" ToolTip="{Binding Text}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
