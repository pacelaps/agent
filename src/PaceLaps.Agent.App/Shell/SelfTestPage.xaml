<UserControl x:Class="PaceLaps.Agent.App.Shell.SelfTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tray="clr-namespace:PaceLaps.Agent.Hosting.Tray;assembly=PaceLaps.Agent.Hosting">
    <!-- The design canvas's "Self-test": the step bar, each step as it finishes, the question waiting. DataContext: SelfTestPageModel. -->
    <DockPanel Margin="28,24,28,24">
        <!-- Head: line, title, step bar -->
        <DockPanel DockPanel.Dock="Top">
            <ItemsControl DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" ItemsSource="{Binding View.Steps}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="34" Height="6" CornerRadius="3" Margin="2,0" Background="{Binding Converter={StaticResource StepBar}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Foreground="{Binding View.Result, Converter={StaticResource CheckResult}, ConverterParameter=brand}" Text="{Binding View.Eyebrow, Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                <TextBlock Style="{StaticResource Display}" FontSize="52" LineHeight="50" Margin="0,8,0,0" Text="SELF-TEST" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}" Margin="0,10,0,0" Text="{Binding View.Sentence}" />

        <!-- The question waiting for an answer -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18" Background="#0D1426" BorderBrush="{StaticResource BrandBorder}"
                Visibility="{Binding Asking, Converter={StaticResource Shown}}">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="ExtraBold" TextWrapping="Wrap" Text="{Binding Asking}" />
                <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,6,0,0" Text="Answer it in the window in front of iRacing." />
            </StackPanel>
        </Border>

        <!-- Run it -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding View.CanRun, Converter={StaticResource Shown}}">
            <Button Style="{StaticResource BtnPrimary}" Content="Run the self-test" Command="{Binding RunCommand}" />
        </StackPanel>

        <!-- The steps -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,4" VerticalAlignment="Top">
            <ItemsControl ItemsSource="{Binding View.Steps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Padding="0,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="Mark" Grid.Column="0" Content="{Binding Check}" ContentTemplate="{StaticResource CheckMark}" Focusable="False" HorizontalAlignment="Left" />
                                <Path x:Name="Spinner" Grid.Column="0" Visibility="Collapsed" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                                      Data="M21,12 A9,9 0 1 1 14.8,3.4" Stroke="{StaticResource BrandText}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="Title" Grid.Column="1" FontSize="14" FontWeight="Bold" Text="{Binding Title}" />
                                <TextBlock x:Name="Text" Grid.Column="2" FontSize="14" Foreground="{StaticResource FgMuted}" Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Number}" Value="1">
                                <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static tray:StepState.Running}">
                                <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource BrandText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static tray:StepState.Pending}">
                                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource FgDisabled}" />
                                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource FgDisabled}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</UserControl>
