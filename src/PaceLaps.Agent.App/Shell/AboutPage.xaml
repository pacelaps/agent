<UserControl x:Class="PaceLaps.Agent.App.Shell.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:PaceLaps.Agent.App.Shell">
    <!-- About and help. DataContext: AboutPageModel. -->
    <StackPanel Margin="28,24,28,24">
        <TextBlock Style="{StaticResource Display}" FontSize="46" LineHeight="44" Text="ABOUT AND HELP" />

        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22">
            <DockPanel>
                <Image DockPanel.Dock="Left" Width="64" Height="64" VerticalAlignment="Top" Source="pack://application:,,,/Assets/logo-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="20,0,0,0">
                    <TextBlock FontSize="20" FontWeight="Bold" Text="PaceLaps Agent" />
                    <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0" Foreground="{StaticResource FgMuted}" Text="{Binding Version}" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="{Binding Server}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Types race control's commands into iRacing and tells Race Control what happens on track. It doesn't modify iRacing: it reads the session through iRacing's SDK and uses the admin commands iRacing gives session admins. PaceLaps is not affiliated with iRacing." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding Source='Help', Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                    <Button Style="{StaticResource LinkButton}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Left" Content="The agent guide"
                            Command="{Binding OpenCommand}" CommandParameter="{x:Static shell:AboutPageModel.Guide}" />
                    <Button Style="{StaticResource LinkButton}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Left" Content="When something is wrong"
                            Command="{Binding OpenCommand}" CommandParameter="{x:Static shell:AboutPageModel.Troubleshooting}" />
                    <Button Style="{StaticResource LinkButton}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Left" Content="Write to support@pacelaps.com"
                            Command="{Binding OpenCommand}" CommandParameter="mailto:support@pacelaps.com" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{Binding Source='Updates and source', Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                    <Button Style="{StaticResource LinkButton}" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Left" Content="What's new (download page)"
                            Command="{Binding OpenCommand}" CommandParameter="{x:Static shell:AboutPageModel.Download}" />
                    <Button Style="{StaticResource LinkButton}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Left" Content="Source code (GNU GPL version 3)"
                            Command="{Binding OpenCommand}" CommandParameter="{x:Static shell:AboutPageModel.Source}" />
                    <Button Style="{StaticResource LinkButton}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Left" Content="Licences of the libraries and fonts"
                            Command="{Binding OpenLicencesCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
