<UserControl x:Class="PaceLaps.Agent.App.Shell.PairingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The design canvas's "Pairing": the code in large characters, Copy, Open the pairing page, the time left. DataContext: PairingPageModel. -->
    <Grid>
        <Button Style="{StaticResource LinkButton}" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24,0,0" Command="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal">
                <Path Data="M15,18 L9,12 L15,6" Style="{StaticResource NavIcon}" Width="14" Height="14" Stroke="{StaticResource BrandText}" />
                <TextBlock Text="Back" Margin="6,0,0,0" />
            </StackPanel>
        </Button>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
            <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource BrandText}" HorizontalAlignment="Center"
                       Text="{Binding Source='Step 1 of 3', Converter={StaticResource Upper}, ConverterParameter=spaced}" />
            <TextBlock Style="{StaticResource Display}" FontSize="54" LineHeight="52" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" Text="PAIR WITH RACE CONTROL" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" TextAlignment="Center" MaxWidth="520"
                       Text="Open the pairing page as a steward of your league and enter this code. It works for 10 minutes." />

            <!-- Local builds: the server's address -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0" Visibility="{Binding AsksForServer, Converter={StaticResource Shown}}">
                <TextBox Style="{StaticResource Field}" Width="320" Text="{Binding ServerText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Race Control's address" />
                <Button Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" MinHeight="36" Content="Get a code" Command="{Binding StartCommand}" />
            </StackPanel>

            <!-- The code -->
            <ItemsControl Margin="0,26,0,0" HorizontalAlignment="Center" ItemsSource="{Binding Code}" Focusable="False"
                          Visibility="{Binding HasCode, Converter={StaticResource Shown}}" AutomationProperties.Name="Pairing code">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border x:Name="Box" Width="58" Height="76" Margin="4,0" CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineControl}" BorderThickness="1">
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="40" Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Dash" Width="16" Height="4" Margin="10,0" CornerRadius="2" Background="{StaticResource LineControl}" Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Dash}" Value="True">
                                <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0" Visibility="{Binding HasCode, Converter={StaticResource Shown}}">
                <Button Style="{StaticResource Btn}" Command="{Binding CopyCodeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M9,9 H20 A2,2 0 0 1 22,11 V20 A2,2 0 0 1 20,22 H11 A2,2 0 0 1 9,20 Z M5,15 H4 A2,2 0 0 1 2,13 V4 A2,2 0 0 1 4,2 H13 A2,2 0 0 1 15,4 V5" Style="{StaticResource NavIcon}" Width="16" Height="16" Stroke="{StaticResource Fg}" />
                        <TextBlock Text="Copy the code" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Command="{Binding OpenPageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open the pairing page" />
                        <Path Data="M7,17 L17,7 M8,7 H17 V16" Style="{StaticResource NavIcon}" Width="14" Height="14" Margin="8,0,0,0" Stroke="White" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Waiting -->
            <Border Margin="0,26,0,0" HorizontalAlignment="Center" CornerRadius="22" Padding="18,12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Visibility="{Binding HasCode, Converter={StaticResource Shown}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M21,12 A9,9 0 1 1 14.8,3.4" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource BrandText}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" FontSize="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Text="Waiting for the approval on " />
                    <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding PageText}" />
                    <TextBlock Margin="12,0,0,0" Style="{StaticResource Mono}" Foreground="{StaticResource FgSubtle}" VerticalAlignment="Center" Text="{Binding Remaining}" />
                </StackPanel>
            </Border>

            <!-- Messages and Try again -->
            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Text="{Binding Message}"
                       Visibility="{Binding Message, Converter={StaticResource Shown}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource RedText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource Btn}" Margin="0,14,0,0" HorizontalAlignment="Center" Content="Try again" Command="{Binding StartCommand}"
                    Visibility="{Binding Failed, Converter={StaticResource Shown}}" />
        </StackPanel>
    </Grid>
</UserControl>
