<UserControl x:Class="PaceLaps.Agent.App.Shell.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The design canvas's "First start": the brand side and three steps. DataContext: WelcomePageModel. -->
    <DockPanel>
        <!-- Brand side with the checkered edge -->
        <Grid DockPanel.Dock="Left" Width="380" Background="#0D0D10">
            <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,1,0" />
            <Rectangle Width="18" HorizontalAlignment="Right">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute" Stretch="None">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="{StaticResource Line}" Geometry="M0,0 H9 V9 H0 Z M9,9 H18 V18 H9 Z" />
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <DockPanel Margin="36,40,54,40">
                <Image DockPanel.Dock="Top" HorizontalAlignment="Left" Width="64" Height="64" Source="pack://application:,,,/Assets/logo-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Rectangle Width="48" Height="5" Fill="{StaticResource Green}" Margin="0,0,4,0" />
                    <Rectangle Width="48" Height="5" Fill="{StaticResource Yellow}" Margin="0,0,4,0" />
                    <Rectangle Width="48" Height="5" Fill="{StaticResource Red}" Margin="0,0,4,0" />
                    <Rectangle Width="48" Height="5" Fill="{StaticResource Brand}" Margin="0,0,4,0" />
                    <Rectangle Width="48" Height="5" Fill="{StaticResource Fg}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource BrandText}" Text="{Binding Source='Welcome', Converter={StaticResource Upper}, ConverterParameter=spaced}" />
                    <TextBlock Style="{StaticResource Display}" FontSize="64" LineHeight="60" Margin="0,16,0,0" Text="RACE CONTROL, IN YOUR SIM" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" LineHeight="22"
                               Text="The agent types your stewards' calls into iRacing and tells Race Control what happens on track. It sleeps until you activate it." />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Steps -->
        <DockPanel Margin="44,40,44,40">
            <DockPanel DockPanel.Dock="Bottom">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="13" Content="Read the agent guide" Command="{Binding OpenGuideCommand}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                    <TextBlock Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Text="Start with Windows (asleep)" />
                </StackPanel>
            </DockPanel>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Text="Three steps to your first race" />

                <Border Style="{StaticResource Card}" Padding="18" BorderBrush="{StaticResource BrandBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brand}" VerticalAlignment="Top">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="22" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Pair" Command="{Binding PairCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Pair this PC with Race Control" />
                            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,6,0,0" Text="Once per PC. You enter a short code on the Race Control page, signed in as a steward of your league." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="22" Foreground="{StaticResource FgMuted}" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Join your session in iRacing as an admin" />
                            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,6,0,0" Text="Borderless window works best. Without admin rights the agent can only play replays for the stewards." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="22" Foreground="{StaticResource FgMuted}" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Activate" />
                            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,6,0,0" Text="The self-test types !help and asks whether the reply appeared. Then the agent joins your session by itself." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </DockPanel>
</UserControl>
